# one-c-form-compiler does NOT read .env files. Set these as environment variables
# (system settings, your shell profile or a launcher script); see
# packaging/release/set-env.example.cmd for a ready-made Windows example.
# Everything below is optional: editing forms needs none of it.

# --- OPTIONAL: built-in AI planning (`ai` command). Not needed when an AI agent drives the
#     tool itself via `one-c-form-compiler guide`. ------------------------------------
# Provider: anthropic (Claude, needs `pip install -e ".[claude]"`; not bundled in the
# Windows release build) or openai.
# Credentials live only in the environment variable named below, never in this file.
# ONE_C_FORM_AI_PROVIDER=anthropic
# Empty = provider default (anthropic: claude-opus-5-5). OpenAI needs an explicit model.
ONE_C_FORM_AI_MODEL=
# anthropic: ANTHROPIC_API_KEY (or leave empty to use the SDK's own credentials)
# openai:    OPENAI_API_KEY
ONE_C_FORM_AI_API_KEY_ENV=ANTHROPIC_API_KEY
ONE_C_FORM_AI_TIMEOUT_SECONDS=120
ONE_C_FORM_AI_MAX_INPUT_BYTES=256000
ONE_C_FORM_AI_MAX_OUTPUT_BYTES=64000
ONE_C_FORM_AI_MAX_OUTPUT_TOKENS=16000

# --- Runtime check in 1C (`--runtime-check`, `runtime-check`) ------------------
# Test infobase only: the probe opens the form, lists its elements and closes.
ONE_C_FORM_1CV8=C:\Program Files\1cv8\<version>\bin\1cv8.exe
ONE_C_FORM_INFOBASE=C:\path\to\test\infobase
ONE_C_FORM_INFOBASE_USER=
# Name of the variable that holds the password (not the password itself).
ONE_C_FORM_INFOBASE_PASSWORD_ENV=

# --- Optional: external v8unpack executable instead of the bundled / `python -m v8unpack` one
# ONE_C_FORM_V8UNPACK=
